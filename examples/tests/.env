
GITHUB_BASE_URI=https://api.github.com
HTTPBIN_BASE_URI=https://httpbin.org
JSON_PLACEHOLDER_BASE_URI=https://jsonplaceholder.typicode.com

#regression test for https://github.com/matt-andrews/Tempest/issues/66
#app level env parsing is overly strict breaking any project that loads it
TEST_ENV_WITH_SPACES=My Env Has Spaces

#here we are testing the templating/cascading abilities of environment variables
TEST_ENV_1=Hello
TEST_ENV_2={{ env.TEST_ENV_1 }}, World!
